<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.chenxiaofei.coursescheduleserver.setting.mapper.SettingMapper">

    <select id="listByUser" resultType="com.chenxiaofei.coursescheduleserver.setting.entity.Setting">
        SELECT * FROM setting WHERE user_id = #{userId}
    </select>

    <select id="get" resultType="com.chenxiaofei.coursescheduleserver.setting.entity.Setting">
        SELECT * FROM setting WHERE user_id = #{userId} AND setting_key = #{key}
    </select>

    <insert id="upsert">
        INSERT INTO setting(user_id, setting_key, setting_value) VALUES(#{userId}, #{key}, #{value})
        ON DUPLICATE KEY UPDATE setting_value = #{value}
    </insert>

    <delete id="deleteAllByUser">
        DELETE FROM setting WHERE user_id = #{userId}
    </delete>

</mapper>
